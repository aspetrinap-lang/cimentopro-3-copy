{
  "name": "UserRoleProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do perfil de acesso (ex: Operador de Produ\u00e7\u00e3o, Supervisor de Qualidade)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta do que este perfil pode acessar"
    },
    "permissions": {
      "type": "object",
      "description": "Chaves dos m\u00f3dulos permitidos (true/false): dashboard, orders, history, analysis, stats, costs, pricing, executive_summary, virtual_engineer, machines, lines, molds, maintenance, quality, cadastro, configuracoes, backup",
      "default": {
        "dashboard": true,
        "orders": true,
        "history": false,
        "analysis": false,
        "stats": false,
        "costs": false,
        "pricing": false,
        "executive_summary": false,
        "virtual_engineer": false,
        "machines": false,
        "lines": false,
        "molds": false,
        "maintenance": false,
        "quality": false,
        "cadastro": false,
        "configuracoes": false,
        "backup": false
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}